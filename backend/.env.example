# SkillScan Backend Environment Configuration
PORT=5001
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/skillscan?retryWrites=true&w=majority

# Optional: Google Gemini AI API Key (for live multimodal generative AI extraction)
GEMINI_API_KEY=
